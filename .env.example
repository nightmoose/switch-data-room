# Switch agent bridge (the server address, not the Gateway UI).
# Compose publishes this on 127.0.0.1:8000. Switch Console shows the same address.
SWITCH_BRIDGE_URL=http://127.0.0.1:8000

# Registration key from the Gateway API Keys page, or the deployment bootstrap
# token (AGENT_REGISTRATION_TOKEN). Used once, to POST /agents. Not an agent key.
SWITCH_REGISTRATION_KEY=

# Filled after the first successful registration. Leave empty to register.
# The API key is returned once; this file is the place to put it. Never commit .env.
SWITCH_AGENT_ID=
SWITCH_AGENT_API_KEY=

# Stable connection id. Leave empty to generate one and store it under .switch/.
SWITCH_CONNECTION_ID=

# Agent name. Must match ^[a-z0-9][a-z0-9._-]*$
SWITCH_AGENT_NAME=data-gatekeeper

# Room names created by switch-rooms.template.yaml. Ids are optional; the
# agent resolves names with list_rooms when it connects.
SWITCH_INGEST_ROOM=data-ingest
SWITCH_INCIDENTS_ROOM=data-incidents
SWITCH_INGEST_ROOM_ID=
SWITCH_INCIDENTS_ROOM_ID=

# Workspace root for drops, quarantine, and contracts. Paths in chat must stay inside it.
DATA_ROOM_ROOT=.
